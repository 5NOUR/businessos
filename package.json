{
  "name": "businessos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @businessos/web dev",
    "dev:api": "pnpm --filter @businessos/api start:dev",
    "build:web": "pnpm --filter @businessos/web build",
    "build:api": "pnpm --filter @businessos/api build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "prettier": "^3.0.0",
    "packageManager": "pnpm@9.15.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
